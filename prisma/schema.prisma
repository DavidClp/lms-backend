generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum ProfileMode {
  ADULT
  KIDS
}

enum ModuleAudience {
  ADULT
  KIDS
  ALL
}

enum LessonKind {
  LESSON
  EXAM
}

enum DailyMissionType {
  LOGIN
  COMPLETE_LESSON
  QUIZ_CORRECT
}

enum GameType {
  WORD_SEARCH
  HANGMAN
}

enum GameDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id               String                 @id @default(uuid())
  name             String
  email            String                 @unique
  password         String
  role             Role                   @default(STUDENT)
  profileMode      ProfileMode            @default(ADULT) @map("profile_mode")
  totalXp          Int                    @default(0) @map("total_xp")
  level            Int                    @default(1)
  avatarConfig     Json?                  @map("avatar_config")
  currentStreak    Int                    @default(0) @map("current_streak")
  lastActivityDate DateTime?              @map("last_activity_date")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  progress         Progress[]
  moduleAccess     StudentModuleAccess[]
  badges           UserBadge[]
  dailyMissions    DailyMission[]
  gameProgress     GameProgress[]

  @@map("users")
}

model Module {
  id            String                 @id @default(uuid())
  title         String
  description   String?
  order         Int                    @map("order")
  audience      ModuleAudience         @default(ADULT)
  kidsMeta      Json?                  @map("kids_meta")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  lessons       Lesson[]
  studentAccess StudentModuleAccess[]

  @@map("modules")
}

model StudentModuleAccess {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  moduleId String @map("module_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("student_module_access")
}

model Lesson {
  id        String     @id @default(uuid())
  moduleId  String     @map("module_id")
  title     String
  order     Int        @map("order")
  kind      LessonKind @default(LESSON) @map("kind")
  content   Json       @default("[]")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  Progress[]

  @@map("lessons")
}

model Image {
  id        String   @id @default(uuid())
  data      Bytes
  mimeType  String   @default("image/webp") @map("mime_type")
  fileName  String   @map("file_name")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("images")
}

model Progress {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  lessonId            String    @map("lesson_id")
  completed           Boolean   @default(false)
  completedAt         DateTime? @map("completed_at")
  quizResults         Json?     @map("quiz_results")
  openQuestionAnswers Json?     @map("open_question_answers")
  checklistState      Json?     @map("checklist_state")
  gameResults         Json?     @map("game_results")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progress")
}

model Badge {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String
  iconEmoji   String      @default("🏅") @map("icon_emoji")
  xpReward    Int         @default(0) @map("xp_reward")
  createdAt   DateTime    @default(now()) @map("created_at")
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model DailyMission {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  date      DateTime         @db.Date
  type      DailyMissionType
  target    Int              @default(1)
  progress  Int              @default(0)
  completed Boolean          @default(false)
  xpReward  Int              @default(0) @map("xp_reward")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
  @@map("daily_missions")
}

model Game {
  id          String         @id @default(uuid())
  title       String
  description String?
  type        GameType       @default(WORD_SEARCH)
  difficulty  GameDifficulty @default(EASY)
  config      Json
  isActive    Boolean        @default(true) @map("is_active")
  order       Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  progress    GameProgress[]

  @@map("games")
}

model GameProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  gameId      String    @map("game_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  stats       Json?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("game_progress")
}

model PlatformConfig {
  id                     Int      @id @default(1)
  disableStudentPassword Boolean  @default(false) @map("disable_student_password")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

model casamento_confirmacao {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now()) @map("created_at")
  quantidade_pessoas Int      @map("quantidade_convidados")
  nome               String   @map("nome")
  observacao         String?  @map("observacoes")

  @@map("casamento_confirmacao")
}
